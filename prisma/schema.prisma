// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ENUM for user roles
enum Role {
  admin
  vendor
  customer
}

enum HomePageSectionType {
  products
  categories
  banner
  mixed
}

enum HomePageSectionLayout {
  carousel
  grid_2x2
  single_grid
  grid_3x1
  hero
  horizontal_scroll
}

enum AddressType {
  home
  office
  other
}

enum DeliveryAreaStatus {
  active
  inactive
}

enum OrderStatus {
  pending
  confirmed
  processing
  shipped
  out_for_delivery
  delivered
  cancelled
  refunded
}

enum PaymentStatus {
  pending
  processing
  paid
  failed
  refunded
  partially_refunded
}

enum DeliveryStatus {
  pending
  assigned
  dispatched
  in_transit
  delivered
  failed
  returned
}

enum PaymentGateway {
  paystack
  flutterwave
  stripe
  pay_on_delivery
}

model User {
  id              String   @id @db.Text
  name            String
  email           String   @unique
  emailVerified   Boolean  @default(false)

  // Custom fields
  role            Role     @default(customer)
  imageCldPubId   String?
  image           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Relations
  sessions        Session[]
  accounts        Account[]
  productsCreated Product[] @relation("ProductCreatedBy")
  productsUpdated Product[] @relation("ProductUpdatedBy")
  cart            Cart?
  addresses        Address[]
  orders           Order[]
}

model Department {
  id              Int       @id @default(autoincrement())
  name            String
  slug            String    @unique
  metaTitle       String?   
  metaDescription String?
  active          Boolean   @default(true)
  bannerCldPubId  String?
  bannerUrl       String?
  bannerAltText   String?
  deletedAt       DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  categories      Category[]
  products        Product[]
}

model Category {
  id           Int       @id @default(autoincrement())
  name         String
  slug           String    @unique
  metaTitle       String?   
  metaDescription String?
  departmentId Int
  department   Department @relation(fields: [departmentId], references: [id])

  parentId Int?
  parent   Category?  @relation("CategoryParent", fields: [parentId], references: [id])
  children Category[] @relation("CategoryParent")

  active    Boolean   @default(true)
  bannerCldPubId  String?
  bannerUrl       String?
  bannerAltText   String?
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt


  products  Product[]
  sectionItems HomePageSectionItem[]

  @@unique([name, departmentId])
}

model Product {
  id             Int       @id @default(autoincrement())
  name           String  
  slug           String    @unique
  description    Json      @db.JsonB
  descriptionHtml String   @default("")
  images         ProductImage[]
  departmentId   Int
  department     Department @relation(fields: [departmentId], references: [id])
  categoryId     Int
  category       Category   @relation(fields: [categoryId], references: [id])
  status         String
  price          Decimal   @db.Decimal(20, 4)
  quantity       Int?
  metaTitle      String?
  metaDescription String?
  hasVariations  Boolean   @default(false)
  createdBy      String   @db.Text
  createdByUser  User      @relation("ProductCreatedBy", fields: [createdBy], references: [id])
  updatedBy      String   @db.Text
  updatedByUser  User      @relation("ProductUpdatedBy", fields: [updatedBy], references: [id])
  deletedAt      DateTime?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  attributes      ProductAttribute[]
  skus            ProductSku[]
  sectionItems HomePageSectionItem[]
  cartItems    CartItem[]
  orderItems       OrderItem[]

  @@index([status])
  @@index([hasVariations])
}

model ProductImage {
  id              Int       @id @default(autoincrement())

  imageUrl        String
  imageCldPubId   String

  imageAltText    String

  productId       Int
  product         Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  isPrimary       Boolean  @default(false) // main image
  order           Int      @default(0)     // for sorting

  createdAt       DateTime @default(now())
}

model ProductAttribute {
  id         Int       @id @default(autoincrement())
  productId  Int
  product    Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  name       String
  type       String
  values     ProductAttributeValue[]

  @@unique([productId, name])
}

model ProductAttributeValue {
  id                  Int                    @id @default(autoincrement())
  productAttributeId  Int
  productAttribute    ProductAttribute       @relation(fields: [productAttributeId], references: [id], onDelete: Cascade)
  value               String
  images         ProductAttributeValueImage[]
  skus           ProductSku[]
}

model ProductAttributeValueImage {
  id              Int       @id @default(autoincrement())

  imageUrl        String
  imageCldPubId   String

  imageAltText    String

  productAttributeValueId Int
  productAttributeValue ProductAttributeValue @relation(fields: [productAttributeValueId], references: [id], onDelete:Cascade)

  isPrimary       Boolean  @default(false) // main image
  order           Int      @default(0)     // for sorting

  createdAt       DateTime @default(now())
}

model ProductSku {
  id                  Int                    @id @default(autoincrement())
  productId           Int
  product             Product                @relation(fields: [productId], references: [id], onDelete: Cascade)
  sku                 String                 @unique
  price               Decimal                @db.Decimal(20, 4)
  quantity            Int
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt
  attributeValues     ProductAttributeValue[]

  orderItems       OrderItem[]
}

model HomePageSectionGroup {
  id          Int      @id @default(autoincrement())

  isFullWidth Boolean  @default(true)

  position    Int

  active      Boolean  @default(true)

  sections    HomePageSection[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model HomePageSection {
  id            Int      @id @default(autoincrement())

  title         String
  slug          String   @unique

  ctaText       String 

  type          HomePageSectionType
  layout        HomePageSectionLayout

  active        Boolean  @default(true)

  position      Int      @default(0) @unique

  config        Json?    @db.JsonB

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  groupId Int?
  group HomePageSectionGroup? @relation(fields: [groupId], references: [id])

  items         HomePageSectionItem[]

  @@index([active])
  @@index([position])
}

model HomePageSectionItem {
  id            Int @id @default(autoincrement())

  sectionId     Int
  section HomePageSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  productId     Int?
  product Product? @relation(fields: [productId], references: [id], onDelete: Cascade)

  categoryId    Int?
  category Category? @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  imageUrl      String?

  position      Int @default(0)

  @@unique([sectionId, productId])
  @@unique([sectionId, categoryId])
  @@unique([sectionId, position])
}

model Cart {
  id Int @id @default(autoincrement())

  guestToken String? @unique

  userId      String?   @db.Text @unique
  user    User?     @relation(fields: [userId], references: [id], onDelete: Cascade)

  items CartItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CartItem {
  id            Int @id @default(autoincrement())
  
  productId     Int
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  cartId    Int
  cart      Cart @relation(fields: [cartId], references: [id])

  quantity Int
  price          Decimal   @db.Decimal(20, 4)
  productSkuId    Int?

  saveForLater Boolean @default(false)

  createdAt     DateTime @default(now())

  @@index([cartId])
   
}

model DeliveryArea {
  id                Int                 @id @default(autoincrement())
  name              String              @unique
  slug              String              @unique

  // Delivery pricing
  baseFee           Decimal             @db.Decimal(20, 4)

  // Delivery time estimate
  minDeliveryDays   Int?
  maxDeliveryDays   Int?
  minDeliveryHours  Int?
  maxDeliveryHours  Int?

  // Optional free delivery threshold
  freeDeliveryFrom  Decimal?            @db.Decimal(20, 4)

  // Optional geofencing / map support
  latitude          Decimal?            @db.Decimal(10, 7)
  longitude         Decimal?            @db.Decimal(10, 7)
  radiusKm          Decimal?            @db.Decimal(10, 2)

  status            DeliveryAreaStatus  @default(active)

  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  addresses         Address[]
  orders            Order[]
}

model Address {
  id                 Int           @id @default(autoincrement())

  userId             String        @db.Text
  user               User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  deliveryAreaId     Int?
  deliveryArea       DeliveryArea? @relation(fields: [deliveryAreaId], references: [id])

  firstName          String
  lastName           String?
  email              String
  phone              String

  addressLine1       String
  addressLine2       String?
  city               String?
  state              String?
  postalCode         String?
  country            String?       @default("Nigeria")

  landmark           String?
  label              String?       // e.g. Home, Office
  type               AddressType?  // home / office / other
  notes              String?       // delivery instruction

  // map / geocode fields
  latitude           Decimal?      @db.Decimal(10, 7)
  longitude          Decimal?      @db.Decimal(10, 7)
  placeId            String?
  formattedAddress   String?

  isDefault          Boolean       @default(false)

  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  orders             Order[]

  @@index([userId])
  @@index([deliveryAreaId])
}

model Order {
  id                   Int             @id @default(autoincrement())

  invoiceId            String          @unique

  userId               String          @db.Text
  user                 User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Optional reference to saved address used for this order
  addressId            Int?
  address              Address?        @relation(fields: [addressId], references: [id])

  // Snapshot of the address at order time
  addressSnapshot      Json            @db.JsonB

  deliveryAreaId       Int?
  deliveryArea         DeliveryArea?   @relation(fields: [deliveryAreaId], references: [id])

  discount             Decimal         @default(0) @db.Decimal(20, 4)
  deliveryCharge       Decimal         @default(0) @db.Decimal(20, 4)
  subtotal             Decimal         @db.Decimal(20, 4)
  grandTotal           Decimal         @db.Decimal(20, 4)
  productQty           Int

  currency             String?         @default("NGN")

  paymentGateway       PaymentGateway?
  paymentMethod        String?         // optional display label
  paymentStatus        PaymentStatus   @default(pending)
  paidAt               DateTime?
  transactionId        String?

  couponCode           String?
  couponInfo           Json?           @db.JsonB

  orderStatus          OrderStatus     @default(pending)
  deliveryStatus       DeliveryStatus  @default(pending)

  deliveredAt          DateTime?
  cancelledAt          DateTime?
  cancellationReason   String?

  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt

  items                OrderItem[]
  payments             PaymentTransaction[]

  @@index([userId])
  @@index([invoiceId])
  @@index([paymentStatus])
  @@index([orderStatus])
  @@index([deliveryStatus])
  @@index([deliveryAreaId])
}

model OrderItem {
  id                     Int         @id @default(autoincrement())

  orderId                Int
  order                  Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)

  productId              Int
  product                Product     @relation(fields: [productId], references: [id])

  // if product has variations, store the exact SKU purchased
  productSkuId           Int?
  productSku             ProductSku? @relation(fields: [productSkuId], references: [id])

  // snapshot fields so order history survives product edits/deletes
  productName            String
  productSlug            String?
  productImageUrl        String?

  unitPrice              Decimal     @db.Decimal(20, 4)
  quantity               Int
  lineTotal              Decimal     @db.Decimal(20, 4)

  // snapshot of chosen variation values, e.g. Size=XL, Color=Black
  selectedAttributes     Json?       @db.JsonB

  createdAt              DateTime    @default(now())
  updatedAt              DateTime    @updatedAt

  @@index([orderId])
  @@index([productId])
  @@index([productSkuId])
}

model PaymentTransaction {
  id                    Int             @id @default(autoincrement())

  orderId               Int
  order                 Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)

  gateway               PaymentGateway
  reference             String?         @unique
  transactionId         String?
  providerResponse      Json?           @db.JsonB

  amount                Decimal         @db.Decimal(20, 4)
  currency              String          @default("NGN")

  status                PaymentStatus   @default(pending)
  paidAt                DateTime?
  failedAt              DateTime?

  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt

  @@index([orderId])
  @@index([gateway])
  @@index([status])
}

model Session {
  id          String   @id @db.Text
  userId      String   @db.Text
  token       String   @unique
  expiresAt   DateTime
  ipAddress   String?
  userAgent   String?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], name: "idx_session_userId")
}

model Account {
  id                        String   @id @db.Text
  userId                    String   @db.Text
  accountId                 String
  providerId                String

  accessToken               String?
  refreshToken              String?
  accessTokenExpiresAt      DateTime?
  refreshTokenExpiresAt     DateTime?
  scope                     String?
  idToken                   String?
  password                  String?

  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt

  // Relations
  user                      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], name: "idx_account_userId")
  @@unique([providerId, accountId], name: "uq_account_provider_account")
}

model Verification {
  id          String   @id @db.Text
  identifier  String
  value       String
  expiresAt   DateTime

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([identifier], name: "idx_verification_identifier")
}